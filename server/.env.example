PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/anubhuti_group?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/anubhuti_group

# JWT Secret Key
JWT_SECRET=anubhuti_jwt_ultra_secure_secret_key_2026_luxury_group
JWT_EXPIRE=7d

# Admin Default Credentials (for initial auto-seed)
DEFAULT_ADMIN_EMAIL=admin@anubhutigroup.com
DEFAULT_ADMIN_PASSWORD=Admin@Anubhuti2026#

# Cloudinary Configuration (Optional - for direct media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer / SMTP Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=inquiries@anubhutigroup.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=info@anubhutigroup.com

